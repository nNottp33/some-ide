{
  "name": "some-ide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w apps/classic run dev --",
    "build": "npm -w apps/classic run build",
    "preview": "npm -w apps/classic run preview --",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}

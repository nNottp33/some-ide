{
  "name": "@some/mobile-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "P0 spike: CodeMirror 6 as the phone editor (Thai word navigation, extra keys, soft-keyboard layout, on-device checklist). Open it on a phone over the LAN with `npm run dev -w apps/mobile-spike -- --host`.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14"
  }
}
